@{
    Layout = "_CompanyLayout";
    ViewData["Title"] = "Company Chat - AsanZindagi";
    var users = ViewBag.Users as IEnumerable<dynamic>;
    var companyId = ViewBag.CompanyId;

}

<!-- DataTables CSS -->
<link rel="stylesheet" href="~/admin/assets/plugins/datatable/css/dataTables.bootstrap5.min.css" />

<style>

    .chat-container {
        display: flex;
        height: 77vh;
        border: 1px solid #ccc;
        border-radius: 10px;
        font-family: Arial, sans-serif;
    }

    /* Sidebar */
    .chat-company-sidebar {
        background: #1E1F2F;
        overflow-y: auto;
        border-radius: 10px 0px 0px 10px;
    }

        .chat-company-sidebar h4 {
        padding: 11px;
        background: #1E1F2F;
        color: #FFFFFF;
        margin: 0;
        border-bottom: 1px solid #ddd;
    }

    .chat-company-sidebar ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .chat-company-sidebar li {
        padding: 12px 15px;
        color: white;
        cursor: pointer;
        border-bottom: 1px solid #ddd;
        transition: background 0.2s;
    }

    .chat-company-sidebarr li:hover {
        background: #F5A526;
    }

    /* Chat Window */
    .chat-company-window {
        height: 76vh;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .chat-comapny-header {
        padding: 15px;
        background: #1E1F2F;
        color: white;
        font-weight: bold;
        border-bottom: 1px solid #ddd;
        border-radius: 0px 10px 0px 0px;
    }

    .chat-company-msg {
        flex: 1;
        padding: 15px;
        background: #FFFFFF;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
    }

    /* Chat bubbles */
    .message {
        color: white;
        max-width: 60%;
        padding: 10px 14px;
        border-radius: 8px;
        margin-bottom: 10px;
        font-size: 14px;
        line-height: 1.4;
        display: inline-block;
    }

        .message.user {
            background: #1E1F2F;
            align-self: flex-end;
            text-align: right;
        }

        .message.company {
            background: #F5A526;
            align-self: flex-start;
            text-align: left;
        }

    /* Input */
    .chat-company-input {
        padding: 10px;
        padding-top: 15px;
        border-top: 1px solid #ddd;
        display: flex;
        background: #F0F1F1;
    }

        .chat-company-input input {
            flex: 1;
            padding: 10px;
            border: none;
            border-radius: 20px;
            outline: none;
        }

        .chat-company-input button {
            margin-left: 10px;
            padding: 10px 16px;
            background: #F5A526;
            border: none;
            border-radius: 20px;
            color: white;
            cursor: pointer;
        }

            .chat-company-input button:hover {
                background: #1E1F2F;
            }

   
</style>

<main class="main-wrapper">
    <div class="main-content">

        <div class="row chat-container">
            <div class="column col-md-4 chat-company-sidebar p-0">
                <h4>Users</h4>
                <ul>
                    @foreach (var user in users)
                    {
                        <li onclick="openChat(@user.Id, '@user.Name')">
                            <strong>@user.Name</strong><br />
                            <small>@user.Email</small>
                        </li>
                    }
                </ul>

            </div>
            <div class="column col-md-8 p-0" >
                <!-- Chat Window -->
                <div class="chat-company-window">
                    <div id="chatHeader" class="chat-comapny-header">
                        Select a user to start chat
                    </div>

                    <div id="chatMessages" class="chat-company-msg"></div>

                    <div class="chat-company-input">
                        <input id="messageInput" type="text" placeholder="Type a message" />
                        <button onclick="sendMessage()">Send</button>
                    </div>
                </div>

            </div>

       </div>

    </div>
</main>





@section Scripts {
    <!-- DataTables JS -->
    <script src="~/admin/assets/plugins/datatable/js/jquery.dataTables.min.js"></script>
    <script src="~/admin/assets/plugins/datatable/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/admin/assets/plugins/datatable/js/dataTables.buttons.min.js"></script>
    <script src="~/admin/assets/plugins/datatable/js/buttons.bootstrap5.min.js"></script>
    <script src="~/admin/assets/plugins/datatable/js/jszip.min.js"></script>
    <script src="~/admin/assets/plugins/datatable/js/pdfmake.min.js"></script>
    <script src="~/admin/assets/plugins/datatable/js/vfs_fonts.js"></script>
    <script src="~/admin/assets/plugins/datatable/js/buttons.html5.min.js"></script>
    <script src="~/admin/assets-old/plugins/datatable/js/buttons.print.min.js"></script>
    <!-- Font Awesome for icons in buttons -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/js/all.min.js"></script>

    <script>
        let currentUserId = null;
        let companyId = '@companyId';

        // Open chat with user
        function openChat(userId, userName) {
            currentUserId = userId;
            document.getElementById("chatHeader").innerText = userName;

            // Ensure conversation exists
            fetch(`/api/chat/ensure-conversation`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ userId: userId, companyId: companyId })
            })
            .then(res => res.json())
            .then(conv => {
                loadMessages(conv.id);
                document.getElementById("chatMessages").setAttribute("data-convId", conv.id);
            });
        }

        // Load messages
        // function loadMessages(conversationId) {
        //     fetch(`/api/messages/${conversationId}`)
        //         .then(res => res.json())
        //         .then(messages => {
        //             let box = document.getElementById("chatMessages");
        //             box.innerHTML = "";
        //             messages.forEach(m => {
        //                 let div = document.createElement("div");
        //                 div.innerHTML = `<b>${m.senderType}:</b> ${m.text}`;
        //                 box.appendChild(div);
        //             });
        //             box.scrollTop = box.scrollHeight;
        //         });
        // }

                // Load messages
        function loadMessages(conversationId) {
            fetch(`/api/messages/${conversationId}`)
                .then(res => res.json())
                .then(messages => {
                    let box = document.getElementById("chatMessages");
                    box.innerHTML = "";
                    messages.forEach(m => {
                        let div = document.createElement("div");
                        div.classList.add("message");

                        if (m.senderType === "User") {
                            div.classList.add("company"); // Left side (user bubble)
                        } else {
                            div.classList.add("user"); // Right side (company bubble)
                        }

                        div.innerText = m.text;
                        box.appendChild(div);
                    });
                    box.scrollTop = box.scrollHeight;
                });
        }

        // Send message
        function sendMessage() {
            let text = document.getElementById("messageInput").value;
            if (!text || !currentUserId) return;

            let convId = document.getElementById("chatMessages").getAttribute("data-convId");

            fetch(`/api/messages/send`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    conversationId: convId,
                    text: text,
                    senderType: "Company",
                    senderId: companyId
                })
            }).then(() => {
                document.getElementById("messageInput").value = "";
                loadMessages(convId);
            });
        }
    </script>

}